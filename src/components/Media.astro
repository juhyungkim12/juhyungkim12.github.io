---
import type {Media} from '../lib/content';
interface Props extends Partial<Media> {label?:string;featured?:boolean}
const {image,video,alt='',caption,label='Research media to be added',featured=false}=Astro.props;
---
<figure class:list={['media',{'featured-media':featured}]}>
  {video ? <div class="video-wrap">
    <video muted loop playsinline preload={featured ? 'metadata' : 'none'} poster={image||undefined} aria-label={alt||label} data-featured={featured?'true':undefined} controls={!featured}>
      <source src={video} type="video/mp4"/>Your browser does not support this video.
    </video>
    {featured && <button class="video-toggle" type="button" aria-label="Play research video" data-paused="true">
      <svg class="play-icon" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5 3L13 8L5 13Z" fill="currentColor"/></svg>
      <svg class="pause-icon" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5 3V13M11 3V13" stroke="currentColor" stroke-width="2"/></svg>
    </button>}
  </div> : image ? <img src={image} alt={alt} loading={featured?'eager':'lazy'} width="1200" height="800"/> : <div class="media-placeholder"><span class="placeholder-mark" aria-hidden="true">＋</span><span>{label}</span><small>MEDIA PLACEHOLDER</small></div>}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<script>
for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-featured]')) {
  const button = video.parentElement?.querySelector<HTMLButtonElement>('.video-toggle');
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  const sync = () => {
    if (!button) return;
    button.dataset.paused = String(video.paused);
    button.setAttribute('aria-label', video.paused ? 'Play research video' : 'Pause research video');
  };
  const apply = () => {
    video.autoplay = !preference.matches;
    if (preference.matches) video.pause();
    else video.play().catch(sync);
    sync();
  };
  button?.addEventListener('click', () => {
    if (video.paused) video.play().catch(sync);
    else video.pause();
  });
  video.addEventListener('pointerdown', event => {
    if (event.pointerType === 'touch') button?.focus({preventScroll: true});
  });
  video.addEventListener('play', sync);
  video.addEventListener('pause', sync);
  preference.addEventListener('change', apply);
  apply();
}
</script>
