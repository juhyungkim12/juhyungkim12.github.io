---
import {profile,contact} from '../lib/content';import Media from './Media.astro';import CVDownload from './CVDownload.astro';
const caption = profile.caption === 'Research in motion — featured video to be added.' ? '' : profile.caption;
---
<section class="profile-hero"><div class="profile">{profile.portrait?<img class="portrait" src={profile.portrait} alt={profile.portraitAlt} width="144" height="168"/>:<div class="portrait portrait-placeholder"><span>JK</span><small>PORTRAIT TO BE ADDED</small></div>}<p class="eyebrow">ACADEMIC RESEARCH PORTFOLIO</p><h1>{profile.name}</h1><p class="affiliation">{profile.affiliation}</p><p class="intro">{profile.introduction}</p>{profile.interests.length>0&&<div class="interests"><span>Research interests</span><p>{profile.interests.join(' · ')}</p></div>}<div class="profile-links"><CVDownload compact/>{contact.scholar&&<a href={contact.scholar}>Google Scholar ↗</a>}</div></div><div class="hero-research"><Media image={profile.poster} video={profile.video} alt="Featured research video" caption={caption} label="Featured research video" featured/></div></section>